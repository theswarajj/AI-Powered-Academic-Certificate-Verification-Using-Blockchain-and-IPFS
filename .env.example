# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' inside 'blockchain-smart-contract/blockchain/.env'
# and fill in your actual credentials.
#
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GITHUB!
# ==============================================================================

# Blockchain RPC Providers (e.g., Alchemy or Infura)
AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_AMOY_RPC_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_SEPOLIA_KEY

# Deployer / Admin Wallet Private Key (MetaMask testnet wallet)
PRIVATE_KEY=your_ethereum_private_key_without_0x

# Pinata Cloud IPFS JWT Token (v3 API)
PINATA_JWT=your_pinata_jwt_token_here
